# Template for a filestash stack config.
# Rendered by `just gcp-pulumi scaffold-filestash-stack`. The Ingress block is
# for clusters with no gateway/Pulumi.<stack>.yaml. It stays off until the
# route step: set ingress.hosts.0, then ingress.enabled=true.
# Replace every <...> value before deploy; validation rejects placeholders.
config:
  filestash:properties:
    name: filestash
    namespace: __NAMESPACE__
    applicationURL: https://__HOST__
    image:
      name: machines/filestash
      tag: latest
      digest: sha256:89e70f0fccc4dcce3f47e5d490ee961f912a5ffd4e30b98216e3e37e469035e2
    secretName: filestash
    storage:
      size: __STATE_SIZE__
      storageClass: dictycr-balanced
    cacheSizeLimit: 2Gi
    s3:
      endpoint: http://minio.__NAMESPACE__.svc.cluster.local:9000
      region: us-east-1
      label: dictycr-minio
    ingress:
      enabled: false
      className: nginx
      hosts:
        - __HOST__
      tlsSecret: filestash-tls-secret
      label:
        name: kcert.dev/ingress
        value: managed
    backup:
      # Recovery point target in hours. Deployment blocker: set it, then
      # deploy. `just filestash verify` fails when a copy is older.
      maxAgeHours: 0
    plugins:
      image:
        name: dictybase/filestash-plugins
        tag: <plugins-tag>
        digest: <plugins-digest>
