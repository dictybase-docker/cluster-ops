# Template for an event-messenger stack config.
# Rendered by `just gcp-pulumi scaffold-event-messenger-stack` — the config
# block is appended to Pulumi.<stack>.yaml after `pulumi stack init` writes
# the secretsprovider + encryptedkey lines.
#
# All `secrets.name` and `secrets.keys.*` entries are Kubernetes Secret and key
# names (pointers resolved at pod runtime) — keep them plaintext.
# Only `secrets.values.ncbiEmail` and `secrets.values.ncbiTool` have non-secret
# defaults; populate the remaining `secrets.values.*` credentials with
# `just gcp-pulumi set-secret --folder event-messenger --key <path>` before
# running `preview` and `create-resource`.
config:
  event-messenger:properties:
    emailDeployment:
      name: event-messenger-email
      secrets:
        keys:
          cc: eventMessenger.email.cc
          domain: eventMessenger.email.domain
          mailgunApiKey: eventMessenger.email.apiKey
          ncbiApiKey: eventMessenger.email.ncbiApiKey
          ncbiEmail: eventMessenger.email.ncbiEmail
          ncbiTool: eventMessenger.email.ncbiTool
          sender: eventMessenger.email.sender
          senderName: eventMessenger.email.senderName
        name: email-event
        values:
          ncbiEmail: __NCBI_EMAIL__
          ncbiTool: __NCBI_TOOL__
    image:
      name: dictybase/event-messenger
      tag: bootstrap
    issueDeployment:
      name: event-messenger-issue
      secrets:
        keys:
          owner: eventMessenger.github.owner
          repository: eventMessenger.github.repository
          token: eventMessenger.github.token
        name: issue-event
    logLevel: error
    namespace: __NAMESPACE__
    nats:
      subject: __NATS_SUBJECT__
