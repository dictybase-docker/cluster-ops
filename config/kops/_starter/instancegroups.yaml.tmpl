apiVersion: kops.k8s.io/v1alpha2
kind: InstanceGroup
metadata:
  labels:
    kops.k8s.io/cluster: ${KOPS_CLUSTER_NAME}
  name: batch-spot
spec:
  image: ubuntu-os-cloud/ubuntu-2204-jammy-v20240829
  role: Node
  machineType: e2-standard-4
  minSize: 0
  maxSize: 4
  rootVolumeSize: 100
  subnets:
  - us-central1
  zones:
  - us-central1-a
  - us-central1-b
  - us-central1-c
  taints:
  - spot=true:NoSchedule
  nodeLabels:
    pool: batch
  gce:
    preemptible: true
