# Batch/Spot InstanceGroup
# Applied via: just gcp-cluster apply-instancegroups
# Variables: BATCH_MACHINE, BATCH_MIN, BATCH_MAX, NODE_ZONES
apiVersion: kops.k8s.io/v1alpha2
kind: InstanceGroup
metadata:
  name: batch-spot
  labels:
    kops.k8s.io/cluster: ${KOPS_CLUSTER_NAME}
spec:
  role: Node
  machineType: ${BATCH_MACHINE:-e2-standard-4}
  minSize: ${BATCH_MIN:-0}
  maxSize: ${BATCH_MAX:-4}
  rootVolumeSize: 100
  zones:
    - ${NODE_ZONE_A:-us-central1-a}
    - ${NODE_ZONE_B:-us-central1-b}
    - ${NODE_ZONE_C:-us-central1-c}
  taints:
    - spot:true:NoSchedule
  nodeLabels:
    pool: batch
  gce:
    preemptible: true
